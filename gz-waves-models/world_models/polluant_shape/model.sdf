<?xml version='1.0' ?>
<sdf version="1.6">
  <model name="polluant_shape">
    <static>true</static>
    <!-- 
    <plugin
        filename="gz-waves1-waves-model-system"
        name="gz::sim::systems::WavesModel">
      <static>0</static>
      <update_rate>30</update_rate>
      <wave>
        <algorithm>fft</algorithm>
        <tile_size>500</tile_size>
        <cell_count>256</cell_count>
        <wind_speed>5.0</wind_speed>
        <wind_angle_deg>135</wind_angle_deg>
        <steepness>2</steepness>
      </wave>
    </plugin>
    -->

    <link name="base_link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>materials/polluant_shape2.dae</uri>
          </mesh>
        </geometry>
        <!-- 
          Uncomment material if using DYNAMIC_GEOMETRY which uses PBS
          rather than a custom shader
        -->

      <material>
        <double_sided>1</double_sided>          <!-- se for uma superfície fina -->
        <ambient>0 0 0 1</ambient>
        <diffuse>0 0 0 1</diffuse>
        <specular>0 0 0 1</specular>
        <emissive>0.02 0.02 0.02 1</emissive>   <!-- opcional: um “fio” de luz pra não sumir totalmente -->
        <pbr>
          <metal>                                <!-- sem albedo_map -->
            <metalness>0</metalness>
            <roughness>1</roughness>
          </metal>
        </pbr>
      </material>
        <!-- <material>
          <ambient>0.2 0.2 0.3 1.0</ambient>
          <diffuse>0.3 0.3 0.4 1.0</diffuse>
          <specular>0.7 0.7 0.7 0.92</specular>
          <pbr>
            <metal>
              <albedo_map>materials/oil_spill_texture.png</albedo_map>
              <metalness>0</metalness>
              <roughness>0.8</roughness>
            </metal>
          </pbr>
        </material> -->

      </visual>
    </link>
  </model>
</sdf>
